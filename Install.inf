; Rainbow Glow - all contours animated
[Version]
Signature="$CHICAGO$"
Provider="Custom cursor theme"

[DefaultInstall]
CopyFiles=Cursor.Files
AddReg=Cursor.Scheme

[DestinationDirs]
Cursor.Files=10,"Cursors\RainbowGlowDarkGray"

[Cursor.Scheme]
HKCU,"Control Panel\Cursors\Schemes","Rainbow Glow",0x00020000,"%10%\Cursors\RainbowGlowDarkGray\Normal Select.ani,%10%\Cursors\RainbowGlowDarkGray\Help Select.ani,%10%\Cursors\RainbowGlowDarkGray\Working In Background.ani,%10%\Cursors\RainbowGlowDarkGray\Busy.ani,%10%\Cursors\RainbowGlowDarkGray\Precision Select.ani,%10%\Cursors\RainbowGlowDarkGray\Text Select.ani,%10%\Cursors\RainbowGlowDarkGray\Handwriting.ani,%10%\Cursors\RainbowGlowDarkGray\Unavailable.ani,%10%\Cursors\RainbowGlowDarkGray\Vertical Resize.ani,%10%\Cursors\RainbowGlowDarkGray\Horizontal Resize.ani,%10%\Cursors\RainbowGlowDarkGray\Diagonal Resize 1.ani,%10%\Cursors\RainbowGlowDarkGray\Diagonal Resize 2.ani,%10%\Cursors\RainbowGlowDarkGray\Move.ani,%10%\Cursors\RainbowGlowDarkGray\Alternate Select.ani,%10%\Cursors\RainbowGlowDarkGray\Link Select.ani,%10%\Cursors\RainbowGlowDarkGray\Location Select.ani,%10%\Cursors\RainbowGlowDarkGray\Person Select.ani"

